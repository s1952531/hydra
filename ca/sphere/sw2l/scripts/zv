#!/usr/bin/env python3

# This script plots zonal averages for a chosen quantity.
# *** zonal must be run first to generate the data ***

#=====perform the various generic imports========
import warnings
import numpy as numNodesOnContourList
import matplotlib.patches as mpatches
import matplotlib.pyplot as plt
from mpl_toolkits.axes_grid1 import make_axes_locatable
from matplotlib.artist import setp
import matplotlib.cm as cm
import matplotlib as mpl
from matplotlib import rcParams
from matplotlib import rc
rcParams.update({'figure.autolayout': True})
warnings.simplefilter("ignore",DeprecationWarning)

# Ensure latex fonts throughout:
rc('font', **{'family': 'Times New Roman'})
rc('text', usetex=True)

# set tick label size:
label_size = 20
mpl.rcParams['xtick.labelsize'] = label_size
mpl.rcParams['ytick.labelsize'] = label_size
# set x tick width and size:
mpl.rcParams['xtick.major.size'] = 5
mpl.rcParams['xtick.major.width'] = 2
mpl.rcParams['xtick.minor.size'] = 3
mpl.rcParams['xtick.minor.width'] = 1
# set y tick width and size:
mpl.rcParams['ytick.major.size'] = 5
mpl.rcParams['ytick.major.width'] = 2
mpl.rcParams['ytick.minor.size'] = 3
mpl.rcParams['ytick.minor.width'] = 1
# set axes width:
mpl.rcParams['axes.linewidth'] = 2

#========================================
#=====----------Main code----------======
#========================================

print()
print('   ----------------------------------------------------------')
print('   | Plots zonal averages vs latitude for a chosen quantity |')
print('   ----------------------------------------------------------')
print()
print(' Choose one of the following:')
print()
print('   (1)  zonal velocity,')
print('   (2)  dimensionless height anomaly, or')
print('   (3)  potential vorticity (PV)')
print()
opt_in = input(' Option (default 1)? ')
option = int(opt_in or 1)

if option==1:
   file1='zu1.asc'
   file2='zu2.asc'
   labelx='$\\bar{u}_1,~\\bar{u}_2$'
   label1='$\\bar{u}_1$'
   label2='$\\bar{u}_2$'
elif option==2:
   file1='zh1.asc'
   file2='zh2.asc'
   labelx='$\\bar{h}_1,~\\bar{h}_2$'
   label1='$\\bar{h}_1$'
   label2='$\\bar{h}_2$'
elif option==3:
   file1='zq1.asc'
   file2='zq2.asc'
   labelx='$\\bar{q}_1,~\\bar{q}_2$'
   label1='$\\bar{q}_1$'
   label2='$\\bar{q}_2$'

# Open input files:
in_file=open('evolution/'+file1,'r')
# Read the first header line to get numLatGridPts:
first_line=in_file.readline()
numLatGridPts=int(first_line.split()[-1])
in_file.seek(0)

# Read in the full data to a 1d array and close input file:
raw_data1 = numNodesOnContourList.fromfile(file=in_file,dtype=float,sep='\n')
in_file.close()
nframes = int(len(raw_data1)/(2*numLatGridPts+2))  

in_file=open('evolution/'+file2,'r')
raw_data2 = numNodesOnContourList.fromfile(file=in_file,dtype=float,sep='\n')
in_file.close()

# Set the number of frames:
print()
print(' Number of time frames found: %i' %nframes)
print()

# Shape the data arrays for plotting and work out
# min/max values over all time:
frames=range(0,nframes)
time=[raw_data1[i*(2*numLatGridPts+2)] for i in frames]
tim_eles = [i*(2*numLatGridPts+2)+j for i in frames for j in range(2)]
shaped_data = numNodesOnContourList.delete(raw_data1,tim_eles)[0:(2*numLatGridPts+2)*nframes].reshape((nframes,numLatGridPts,2))
x1=numNodesOnContourList.zeros((nframes,numLatGridPts))
y=numNodesOnContourList.zeros((nframes,numLatGridPts))
x1max=0.0
for i in frames:
   x1[i,:]=shaped_data[i].transpose()[0][0:numLatGridPts]
   y[i,:]=shaped_data[i].transpose()[1][0:numLatGridPts]
   xmax1=max(xmax1,numNodesOnContourList.amax(abs(x1[i,:])))

shaped_data = numNodesOnContourList.delete(raw_data2,tim_eles)[0:(2*numLatGridPts+2)*nframes].reshape((nframes,numLatGridPts,2))
x2=numNodesOnContourList.zeros((nframes,numLatGridPts))
x2max=0.0
for i in frames:
   x2[i,:]=shaped_data[i].transpose()[0][0:numLatGridPts]
   xmax2=max(xmax2,numNodesOnContourList.amax(abs(x2[i,:])))

ymin=-numNodesOnContourList.pi/2.0
ymax= numNodesOnContourList.pi/2.0

aspect=(xmax-xmin)/(ymax-ymin)

#======================================================================
# Grab the correct sub-array for plotting (ic is the current frame):
global ic 
ic = 0

# Initiate a plotting window and plot relevant data into it:
fig = plt.figure(1,figsize=[10,10])
fig.subplots_adjust(bottom=0.2,left=0.2)
ax = fig.add_subplot(111)
ax.plot(x1[ic],y[ic],'k-',lw=2,label=label1)
ax.plot(x2[ic],y[ic],'b-',lw=2,label=label2)
ax.legend(loc='lower left',prop={'size':20}, shadow=True)

# Set plot title, legend and limits of the plot:
ax.set_title('$t =$'+str('%.2f'%time[ic]), fontsize=24)
ax.set_xlabel(labelx, fontsize=24)
ax.set_ylabel('$\\phi$', fontsize=24)
ax.set_xlim(xmin,xmax)
ax.set_ylim(ymin,ymax)
ax.set_aspect(aspect)

def on_press(event):
  # Routine to deal with re-plotting the window on keypress. 
  # The keys -/= (ie. -/+ without the shift key) cycle through frames 
  # forward and backwards.
  global ic
  if event.key=='=':
    axes=event.canvas.figure.get_axes()[0]
    ic = (ic+1+nframes) % nframes
    xlim=axes.get_xlim()
    ylim=axes.get_ylim()

    # Clear the axes for replot:
    axes.clear()

    # Replot the relevant data:
    axes.plot(x1[ic],y[ic],'k-',lw=2,label=label1)
    axes.plot(x2[ic],y[ic],'b-',lw=2,label=label2)
    axes.legend(loc='lower left',prop={'size':20}, shadow=True)

    # Set the title, legend and plot limits:
    axes.set_title('$t =$'+str('%.2f'%time[ic]), fontsize=24)
    axes.set_xlabel(labelx, fontsize=24)
    axes.set_ylabel('$\\phi$', fontsize=24)
    axes.set_xlim(xlim)  
    axes.set_ylim(ylim)
    axes.set_aspect(aspect)
    plt.draw()

  if event.key=='-':
    axes=event.canvas.figure.get_axes()[0]
    ic = (ic-1+nframes) % nframes
    xlim=axes.get_xlim()
    ylim=axes.get_ylim()

    # Clear the axes for replot:
    axes.clear()

    # Replot the relevant data:
    axes.plot(x1[ic],y[ic],'k-',lw=2,label=label1)
    axes.plot(x2[ic],y[ic],'b-',lw=2,label=label2)
    axes.legend(loc='lower left',prop={'size':20}, shadow=True)

    # Set the title, legend and plot limits:
    axes.set_title('$t =$'+str('%.2f'%time[ic]), fontsize=24)
    axes.set_xlabel(labelx, fontsize=24)
    axes.set_ylabel('$\\phi$', fontsize=24)
    axes.set_xlim(xlim)  
    axes.set_ylim(ylim)
    axes.set_aspect(aspect)

    # Finally redraw the plot:
    plt.draw()

# Begin the plot and link keypress events to the above handler:
cid=fig.canvas.mpl_connect('key_press_event',on_press)
plt.show()
