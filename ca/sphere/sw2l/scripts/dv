#!/bin/csh

#=========================================================================#
#    Runs dataview on any selected field in the evolution subdirectory
#=========================================================================#

set n=$#argv

if ($n == 0) then
   echo
   echo '  Usage:   dv <field> <options>'
   echo
   echo '  Examples:'
   echo
   echo '  dv qAnom1'
   echo '  dv qAnom1 -mod'
   echo '  dv qAnom1 -mod -glob'
   echo '  dv qAnom1 -lims -1.0 1.0'
   echo '  dv qAnom1 -notitle -cb'
   echo
   echo '  (For all options, just type "dataview")'
   echo
   exit (-1)
else
   set field=$1
endif

# Get resolution
set numLatGridPts = `grep "numLatGridPts=" src/parameters.f90 | awk -F= '{print $(NF-1)}' | awk -F, '{print $1}'`
@ numLongGridPts = ( 2 * $numLatGridPts )

if ($n != 1) then
   # Remove first element of argument list <field> to get <options>:
   shift
   dataview -ndim $numLongGridPts $numLatGridPts {evolution/}$field{.r4} $argv &
else
   dataview -ndim $numLongGridPts $numLatGridPts {evolution/}$field{.r4} &
endif
