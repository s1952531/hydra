#!/bin/csh

#=========================================================================#
#   Job setup script for the spherical sw2l class of f90 codes.
#=========================================================================#

echo
echo '-------------------------------------------------'
echo '       The spherical two-layer shallow-water'
echo '       Combined Lagrangian Advection Method'
echo '-------------------------------------------------'

# Specify code numerical method class:
set meth = "ca"
# Specify code geometry:
set geom = "sphere"
# Specify model equation type:
set equa = "sw2l"
# Specify algorithm:
set algo = "caps"

#==========================================================================
# The following is totally generic!
set local_home = ${HOME}
set hydradir = $local_home/hydra/$meth/$geom/$equa

# Get output base directory:
set workdir=`workdir`
# Make the base data directory if it does not already exist:
if (!(-d $workdir)) mkdir $workdir
set workdir = $workdir/hydra
if (!(-d $workdir)) mkdir $workdir
set basedir = $workdir/$meth
if (!(-d $basedir)) mkdir $basedir
set basedir = $basedir/$geom
if (!(-d $basedir)) mkdir $basedir
set basedir = $basedir/$equa
if (!(-d $basedir)) mkdir $basedir
set basedir = $basedir/$algo
if (!(-d $basedir)) mkdir $basedir

set outdir = $workdir/$meth/$geom/$equa/$algo

# Assign source and binary directories:
set srcdir = $hydradir/$algo
set bindir = $hydradir/scripts

# Get the name of the computer to record in the job_info file below:
set host=`hostname | awk -F. '{print $(1)}'`

#==========================================================================
# generate a random number seed based on current time:
set second=`date +%-S`
set minute=`date +%-M`
set hour=`date +%-H`
set day=`date +%-d`
@ rngSeed = ( $second + ( 60 * ( $minute + 60 * ( $hour + ( 24 * $day ) ) ) ) )

# Create a temporary directory:
set tmpdir = $outdir/tmp{$rngSeed}
mkdir $tmpdir
cd $tmpdir

echo
echo ' *** Job will be built in the temporary directory '
echo $tmpdir

# Create a job information summary file:
touch job_info
echo ' Job created at                      ' `date` >> job_info
echo ' on                                  ' $host >> job_info
echo ' ' >> job_info

# Initialise a jobname string:
set prefix = ""

#==========================================================================
# Set fixed numerical constants:
set pi = 3.14159265358979323846

#==========================================================================
# Set up topography if desired:

set topography = "n"
echo
echo -n ' Include bottom topography (y/n, default' $topography')? '
set var = $<
if ($var != "") set topography = $var

if ($topography == "y") then
   echo
   echo ' The topography eta_b(x,y) is scaled by the lower layer depth.'
   echo
   echo ' Choose one of the following options for eta_b:'
   set topt = 1
   echo ' (1) Random or (2) a localised axisymmetric hill or dip.'
   echo -n ' Option - (default' $topt')? '
   set var = $<
   if ($var != "") set topt = $var
   echo

#-------------------------------------------------------------------
   if ($topt == "1") then

      echo ' ' >> job_info
      echo ' Random topography' >> job_info
      set topgen = "random_top"

      echo ' For the topography spectrum, choose either'
      echo '    (1) narrow band or (2) broad band.'
      echo
      set iopt = 2
      echo -n ' Choice (default' $iopt')? '
      set var = $<
      if ($var != "") set iopt = $var
      echo

      set kb = 16
      echo -n ' Central wavenumber, k_b (integer, default' $kb')? '
      set var = $<
      if ($var != "") set kb = $var
      echo

      if ($iopt == "1") then
         # Narrow band:
         echo ' We consider a flat spectrum between n = n1 and n2.'
         @ minSpherHarmDegree = ( $kb - 2 )
         echo -n ' Starting order, n1 (default' $minSpherHarmDegree')? '
         set var = $<
         if ($var != "") set minSpherHarmDegree = $var
         @ maxSpherHarmDegree = ( $minSpherHarmDegree + 4 )
         echo -n '  Ending  order, n2 (default' $maxSpherHarmDegree')? '
         set var = $<
         if ($var != "") set maxSpherHarmDegree = $var
         echo ' Narrow-band topography' >> job_info
         echo ' between n = ' $minSpherHarmDegree ' and ' $maxSpherHarmDegree >> job_info
      else
         # Broad band:
         echo ' We consider a spectrum S(n) = alpha*exp(-alpha) where'
         echo ' alpha = (n/kb)^3 and n is the spherical harmonic order.'
         set minSpherHarmDegree = 1
         @ maxSpherHarmDegree = ( 9 * ( $kb / 4 ) )
         echo ' Broad-band topography with spectrum' >> job_info
         echo ' S(n) = a*exp(-a) where a = (n/k_b)^3 and k_b = ' $kb >> job_info
      endif

      set bmax = 0.1
      echo -n ' Maximum absolute topographic amplitude  (default' $bmax')? '
      set var = $<
      if ($var != "") set bmax = $var
      echo ' Maximum absolute amplitude of the topography: ' $bmax >> job_info

      echo $minSpherHarmDegree $maxSpherHarmDegree > in_$topgen
      echo $bmax >> in_$topgen

      echo ' Beginning order, n_1:               ' $minSpherHarmDegree >> job_info
      echo ' Ending order,    n_2:               ' $maxSpherHarmDegree >> job_info
      echo ' |eta_b|_max/H_1:                    ' $bmax >> job_info

      # Append to jobname prefix:
      set prefix = {$prefix}rt_

#-------------------------------------------------------------------
   else if ($topt == "2") then

      echo ' ' >> job_info
      echo ' Localised hill/dip topography' >> job_info
      set topgen = "axisym_top"

      echo ' We take eta_b/H_1 = A*exp(-s), where s = 4*(1-Z)/(w^2*(1+Z)),'
      echo ' and where Z is the axial coordinate pointing in the direction'
      echo ' of latitude phi_top and longitude lambda_top.'
      echo
      set amp = 0.1
      echo -n ' Amplitude A (default' $amp')? '
      set var = $<
      if ($var != "") set amp = $var

      set wid = 0.1
      echo -n ' Width w (default' $wid')? '
      set var = $<
      if ($var != "") set wid = $var

      set phi_top = 45.0
      echo -n ' Latitude phi_top (degrees, default' $phi_top')? '
      set var = $<
      if ($var != "") set phi_top = $var

      set lam_top = 0.0
      echo -n ' Longitude lambda_top (degrees, default' $lam_top')? '
      set var = $<
      if ($var != "") set lam_top = $var

      echo $amp $wid > in_$topgen
      echo $phi_top $lam_top >> in_$topgen

      echo ' ' >> job_info
      echo ' We take eta_b/H_1 = A*exp(-s), where s = 4*(1-Z)/(w^2*(1+Z)),' >> job_info
      echo ' and where Z is the axial coordinate pointing in the direction' >> job_info
      echo ' of latitude phi_top and longitude lambda_top.' >> job_info
      echo ' A:                                  ' $amp >> job_info
      echo ' w:                                  ' $wid >> job_info
      echo ' phi_top (degrees):                  ' $phi_top >> job_info
      echo ' lambda_top (degrees):               ' $lam_top >> job_info

      # Append to jobname prefix:
      set prefix = {$prefix}pt_

#-------------------------------------------------------------------
   else

      echo ' Not a valid choice - exiting...'
      /bin/rm -r $tmpdir
      exit(-1)

   endif

   set topflag = ".true."

else
   set topflag = ".false."
endif

#==========================================================================
# Set up the initial PV distribution:
set dataopt = 1
echo
echo ' Choose one of the following flow initialisation methods:'
echo    ' (1) a random baroclinic (mode 2) PV distribution,'
echo    ' (2) a baroclinic (mode 2) jet, or'
echo    ' (3) a state of rest - (default' $dataopt')? ' 
echo -n ' Option - (default' $dataopt')? '
set var = $<
if ($var != "") set dataopt = $var
echo

if ($dataopt == 1) then

#-------------------------------------------------------------------
   # A random PV distribution:
   set datagen = "random_pv"

   echo ' Starting with a random baroclinic PV distribution' >> job_info
   echo ' ' >> job_info

   echo ' For the initial baroclinic PV spectrum, choose either'
   echo '    (1) narrow band or (2) broad band.'
   echo
   set iopt = 2
   echo -n ' Choice (default' $iopt')? '
   set var = $<
   if ($var != "") set iopt = $var
   echo

   set kb = 8
   echo -n ' Central wavenumber, k_b (integer, default' $kb')? '
   set var = $<
   if ($var != "") set kb = $var

   echo
   if ($iopt == "1") then
      # Narrow band:
      echo ' We consider a flat spectrum between n = n1 and n2.'
      @ minSpherHarmDegree = ( $kb - 2 )
      echo -n ' Starting order, n1 (default' $minSpherHarmDegree')? '
      set var = $<
      if ($var != "") set minSpherHarmDegree = $var
      @ maxSpherHarmDegree = ( $minSpherHarmDegree + 4 )
      echo -n '  Ending  order, n2 (default' $maxSpherHarmDegree')? '
      set var = $<
      if ($var != "") set maxSpherHarmDegree = $var
      echo ' Narrow-band initial baroclinic PV spectrum' >> job_info
      echo ' between n = ' $minSpherHarmDegree ' and ' $maxSpherHarmDegree >> job_info
   else
      # Broad band:
      echo ' We consider a spectrum S(n) = alpha*exp(-alpha) where'
      echo ' alpha = (n/kb)^3 and n is the spherical harmonic order.'
      set minSpherHarmDegree = 1
      @ maxSpherHarmDegree = ( 9 * ( $kb / 4 ) )
      echo ' Broad-band initial baroclinic PV spectrum' >> job_info
      echo ' S(n) = a*exp(-a) where a = (n/kb)^3 and kb = ' $kb >> job_info
   endif

   set Ro = 0.5
   echo -n ' Maximum PV-based Rossby number Ro (default' $Ro')? '
   set var = $<
   if ($var != "") set Ro = $var

   echo ' Maximum absolute PV-based Rossby number: ' $Ro >> job_info

   set fpole = `echo "scale=10; 4 * $pi" | bc -l`
   set fmax = `echo "scale=10; $fpole * $Ro" | bc -l`
   echo $minSpherHarmDegree $maxSpherHarmDegree > in_$datagen
   echo $fmax >> in_$datagen

#-------------------------------------------------------------------
else if ($dataopt == "2") then

   # A baroclinic jet
   set datagen = "bcjet"

   echo ' Starting from a baroclinic jet (PV with a Gaussian distribution)' >> job_info
   echo ' ' >> job_info

   echo ' Consider a baroclinic jet with PV anomaly = f*A*exp(-s^2)'
   echo ' where s = (phi-phi_c)/w, f is the Coriolis frequency and'
   echo ' phi_c(lambda) = phi_0+A_2*sin(2*lambda)+A_3*sin(3*lambda).'
   echo
   set robc = 0.5
   echo -n ' Enter the baroclinic Rossby number A (default' $robc')? '
   set var = $<
   if ($var != "") set robc = $var

   set wid  =  10.0
   echo -n ' Width w (degrees, default' $wid')? '
   set var = $<
   if ($var != "") set wid = $var

   set phi_0  =  30.0
   echo -n ' Mean jet latitude phi_0 (degrees, default' $phi_0')? '
   set var = $<
   if ($var != "") set phi_0 = $var

   set amp2  =  0.3
   echo -n ' A_2 (degrees, default' $amp2')? '
   set var = $<
   if ($var != "") set amp2 = $var

   set amp3  = "-0.2"
   echo -n ' A_3 (degrees, default' $amp3')? '
   set var = $<
   if ($var != "") set amp3 = $var
   
   echo ' Baroclinic Rossby number, A:        ' $robc >> job_info
   echo ' Width of the strip, w (degrees):    ' $wid >> job_info
   echo ' Mean jet latitude, phi_0 (degrees): ' $phi_0 >> job_info
   echo ' A_2 (degrees):                      ' $amp2 >> job_info
   echo ' A_3 (degrees):                      ' $amp3 >> job_info

   # Create input file for routine:
   echo $robc $wid > in_$datagen
   echo $phi_0 >> in_$datagen
   echo $amp2 $amp3 >> in_$datagen

   # Append to jobname prefix:
   set prefix = {$prefix}jq_

#-------------------------------------------------------------------
else if ($dataopt == "3") then

   # A state of rest (expect to use stochastic forcing below):
   set datagen = "rest"

   echo ' Starting from a state of rest' >> job_info
   echo ' ' >> job_info

   # Create input file for routine even though none is required:
   echo "0" > in_$datagen

   # Append to jobname prefix:
   set prefix = {$prefix}rest_

#-------------------------------------------------------------------
else

   echo ' Not a valid choice - exiting...'
   /bin/rm -r $tmpdir
   exit(-1)

endif

#==========================================================================
# Choose the main physical parameters by executing a python script:
$bindir/hinvert

# Extract data:
set dum = `cat ini_params.asc`

# Vertical coefficients needed for the height inversion (see hinvert):
set v11 = $dum[1]
set v12 = $dum[2]
set v21 = $dum[3]
set v22 = $dum[4]

# Thicknesses of each layer (they are assumed to sum to 1):
set hAvgLayer1 = $dum[5]
set hAvgLayer2 = $dum[6]

# Upper layer to lower layer density ratio, rho_2/rho_1:
set alpha = $dum[7]

# Acceleration due to gravity:
set gravity = $dum[8]

# Mode short-wave gravity-speeds needed for the height inversion:
set ctsq1 = $dum[9]
set ctsq2 = $dum[10]

#-------------------------------------------------------------------
# Set thermal damping:
set damping = "n"
echo
echo -n ' Include thermal damping y/n (default' $damping')? '
set var = $<
if ($var != "") set damping = $var

if ($damping == "y") then 
   set tau = 250
   echo -n ' Thermal damping time scale, tau (default' $tau')? '
   set var = $<
   if ($var != "") set tau = $var

   set r_th = `echo "1.0 / $tau" | bc -l`
   set t_sim = `echo "scale=1; 20000 + 4*$tau" | bc -l`

   echo ' ' >> job_info
   echo ' Thermal damping time, tau:          ' $tau >> job_info
   echo ' Thermal damping rate, 1/tau:        ' $r_th >> job_info

   # Append to jobname prefix:
   set prefix = {$prefix}th_
else
   set t_sim = 100.0
   set r_th = 0.0
endif

#-------------------------------------------------------------------
# Possibly include stochastic baroclinic PV forcing:
set forcing = "n"
echo
echo -n ' Include stochastic baroclinic PV forcing (y/n, default' $forcing')? '
set var = $<
if ($var != "") set forcing = $var

if ($forcing == "y") then
   echo
   echo ' For the baroclinic PV forcing spectrum, choose either'
   echo '    (1) narrow band or (2) broad band.'
   echo
   set iopt = 2
   echo -n ' Choice (default' $iopt')? '
   set var = $<
   if ($var != "") set iopt = $var
   echo

   set kb = 32
   echo -n ' Central forcing wavenumber, k_b (integer, default' $kb')? '
   set var = $<
   if ($var != "") set kb = $var

   if ($iopt == "1") then
      # Narrow band:
      echo ' We consider a flat spectrum between n = n1 and n2.'
      @ minSpherHarmDegree = ( $kb - 2 )
      echo -n ' Starting order, n1 (default' $minSpherHarmDegree')? '
      set var = $<
      if ($var != "") set minSpherHarmDegree = $var
      @ maxSpherHarmDegree = ( $minSpherHarmDegree + 4 )
      echo -n '  Ending  order, n2 (default' $maxSpherHarmDegree')? '
      set var = $<
      if ($var != "") set maxSpherHarmDegree = $var
      echo ' Narrow-band PV forcing' >> job_info
      echo ' between n = ' $minSpherHarmDegree ' and ' $maxSpherHarmDegree >> job_info
   else
      # Broad band:
      echo ' We consider a spectrum S(n) = alpha*exp(-alpha) where'
      echo ' alpha = (n/kb)^3 and n is the spherical harmonic order.'
      set minSpherHarmDegree = 1
      @ maxSpherHarmDegree = ( 9 * ( $kb / 4 ) )
      echo ' Broad-band PV forcing with spectrum' >> job_info
      echo ' S(n) = a*exp(-a) where a = (n/kb)^3 and kb = ' $kb >> job_info
   endif

   set frms = 0.0025
   echo -n ' R.m.s. forcing rate, f_rms (default' $frms')? '
   set var = $<
   if ($var != "") set frms = $var

   set tq = 40
   echo -n ' Forcing de-correlation time, t_f (default' $tq')? '
   set var = $<
   if ($var != "") set tq = $var

   echo ' R.m.s. amplitude of the forcing:    ' $frms >> job_info
   echo ' Markovian de-correlation time, t_f: ' $tq >> job_info

   # Append to jobname prefix:
   set prefix = {$prefix}fq_

else
   # Set values to enable spectral.f90 to compile
   set frms = 0.0 
   set tq = 1.0
   set minSpherHarmDegree = 1
   set maxSpherHarmDegree = 1
endif

#==========================================================================
# Set all numerical parameters:
set n_lat = 256
echo
echo ' A longitude-latitude grid of dimensions 2*n_lat x n_lat is used.'
echo -n ' Number of latitudes, n_lat (default' $n_lat')? '
set var = $<
if ($var != "") set n_lat = $var

echo ' ' >> job_info
echo ' No. of latitudes, n_lat (half grid):' $n_lat >> job_info
@ n_lon = ( 2 * $n_lat )
echo ' No. of longitudes, 2*n_lat:         ' $n_lon >> job_info

# Latitudinal grid spacing (needed to determine recommended time step):
set gl = `echo "$pi / $n_lat" | bc -l`

# Append to jobname prefix:
set prefix = {$prefix}n{$n_lat}

# Default number of PV jumps (twice the recommended value of 40):
set n_q = 80 
echo ' No. of PV jumps to represent f, n_q:' $n_q >> job_info

#-------------------------------------------------------------------
if ($damping == "y") then 
   set t_csave = `echo "scale=2; $t_sim/25" | bc -l`
   set t_gsave = `echo "scale=3; $t_sim/500" | bc -l`
else
   echo
   set t_gsave = 1.0    # Default grid data save time increment
   echo -n ' Time interval between gridded data saves (default' $t_gsave')? '
   set var = $<
   if ($var != "") set t_gsave = $var

   set t_csave = 10.0   # Default contour data save time increment
   echo -n ' Time interval between contour data saves (default' $t_csave')? '
   set var = $<
   if ($var != "") set t_csave = $var

   echo -n ' Total simulation time (default' $t_sim')? '
   set var = $<
   if ($var != "") set t_sim = $var
endif

echo ' Total simulation time:              ' $t_sim >> job_info
echo ' Time interval between data saves:   ' $t_gsave >> job_info
echo ' Time interval between contour saves:' $t_csave >> job_info
echo ' ' >> job_info

#-------------------------------------------------------------------
# Compute nominal gravity wave speed sqrt(g*H) with H = H_1 + H_2 = 1 here:
set cgw=`echo "scale=12; sqrt($gravity)" | bc -l`

# Choose a marginally gravity-wave resolving time step:
set dt=`echo "scale=14; 2.0*$pi/($n_lat*$cgw)" | bc -l`
echo ' Marginally gravity wave resolving time step = ' 0{$dt}
# Adjust to be a fraction of the grid save time:
set fac=`echo "scale=14; $t_gsave/$dt" | bc -l`
set dt=`echo "scale=14; $t_gsave/$fac:r" | bc -l`
echo ' ... adjusted to = ' 0{$dt}

#-------------------------------------------------------------------
# Use default values for hyperviscosity (applied to divergence only):
set n_nu=3
set d_rate = 20.0

echo ' ***Lap^'{$n_nu} 'Hyperdiffusion used' >> job_info
echo ' Damping on k = n_lat/2 is C*f;    C:' $d_rate >> job_info

#==========================================================================
# Build parameter file with cpp and make all codes:

# Put all these dimensions into the dimens file needed for compilation:
mkdir src
cd src
cp $srcdir/* .
cp -r $hydradir/init .
cp -r $hydradir/post .

echo 
echo " Compiling source files....."
echo " -----------------------------------------------------------------------"

# Use C pre-processor to put chosen parameters $copts into parameters.f90
set copts = "-DN_G=$n_lat -DN_CONTQ=$n_q -DT_SIM={$t_sim}d0 -DT_GSAVE={$t_gsave}d0 -DT_CSAVE={$t_csave}d0 -DT_STEP={$dt}d0 -DV_11={$v11}d0 -DV_12={$v12}d0 -DV_21={$v21}d0 -DV_22={$v22}d0 -DC_MODE1={$ctsq1}d0 -DC_MODE2={$ctsq2}d0 -DH_BAR1={$hAvgLayer1}d0 -DH_BAR2={$hAvgLayer2}d0 -DDEN_RAT={$alpha}d0 -DACC_GRAV={$gravity}d0 -DR_THERM={$r_th}d0 -DD_RATE={$d_rate}d0 -DPOW_HYPER=$n_nu -DFQ_RMS={$frms}d0 -DT_FQ={$tq}d0 -DN_BEG=$minSpherHarmDegree -DN_END=$maxSpherHarmDegree -DI_SEED=$rngSeed -DTOP_FLAG=$topflag"

precomp $copts parameters.f90

# Compile commonly-used codes and move sources to sub-directory:
make $algo setup dgbal zonal $datagen install clean

if ($topography == "y") then
   make $topgen install clean
endif

cd ..
echo " -----------------------------------------------------------------------"
echo 

#==========================================================================
# Execute the data generation routine:
echo ' Generating initial PV distribution...'
$datagen < in_$datagen > out_$datagen

# For topography, execute the topography generation routine:
if ($topography == "y") then
   echo ' Generating (fixed) bottom topography...'
   $topgen < in_$topgen > out_$topgen
endif

#==========================================================================
# Create a directory named after the data generation script:
cd ..
if (!(-d $datagen)) mkdir $datagen
cd $datagen

# Set the job directory name (will be appended by 001, 002 etc...):
echo
echo -n ' Job directory name (default '{$prefix}')? '
set var = $<
if ($var != "") set prefix = $var

# Work out the last run which has been performed:
# first make a bogus empty directory so this works!
mkdir {$prefix}r000
set last_run = `/bin/ls -d {$prefix}r??? | tail -c 4 | head -c 3`
rmdir {$prefix}r000

@ next_run = ( $last_run + 1 )
@ p1 = ( $next_run / 100 )
@ jr = ( $next_run - ( 100 * $p1 ) )
@ p2 = ( $jr / 10 )
@ p3 = ( $jr - ( 10 * $p2 ) )
set pind={$p1}{$p2}{$p3}

set jobdir={$prefix}r{$pind}

#==========================================================================
# Lastly move all data to desired job directory:

# Move temporary directory to job directory:
mv $tmpdir $jobdir
cd $jobdir
set datadir=`pwd`

# Copy handy scripts for viewing fields and diagnostics:
/bin/cp $bindir/sv .
/bin/cp $bindir/zv .
/bin/cp $bindir/dv .
/bin/cp $bindir/ddv .
/bin/cp $bindir/odv .
/bin/cp $bindir/oddv .
/bin/cp $bindir/pog.py .
/bin/cp $bindir/cpog.py .
/bin/cp $bindir/mpog.py .
/bin/cp $bindir/pene.py .
/bin/cp $bindir/phov.py .
/bin/cp $bindir/pangm.py .
/bin/cp $bindir/pcont.py .
/bin/cp $bindir/pdiag.py .

echo ' ' >> job_info
echo ' Job directory:' >> job_info
echo $datadir >> job_info

#==========================================================================
# Go to job directory:
cd $datadir

# Balance initial conditions:
echo
echo ' Balancing initial conditions (setting delta_t = gamma_t = 0) ...'
# Used for initial balancing; log overwritten below:
echo "0" > log
dgbal < log > out_dgbal
tail -3 out_dgbal

echo ' To set the job running, type'
echo cd $datadir
echo bat log $algo
echo
echo ' To monitor progress, type'

echo 'tail -f log'
echo
