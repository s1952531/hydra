#!/bin/csh

#============================================================================#
# Runs diffview on any selected pair of fields in the evolution subdirectory
#============================================================================#

set n=$#argv

if ($n == 0 || $n == 1) then
   echo
   echo '  Usage:   ddv <field1> <field2> <options>'
   echo
   echo '  Shows the difference, field1 - field2.'
   echo
   echo '  Examples:'
   echo
   echo '  ddv d1 bd1 -mod -glob'
   echo '  ddv d1 bd1 -notitle -cb'
   echo
   echo '  (For all options, just type "diffview")'
   echo
   exit (-1)
else
   set f1=$1
   set f2=$2
endif

# Get resolution
set numLatGridPts = `grep "numLatGridPts=" src/parameters.f90 | awk -F= '{print $(NF-1)}' | awk -F, '{print $1}'`
@ numLongGridPts = ( 2 * $numLatGridPts )

if ($n != 2) then
   # Remove first two elements of argument list <field> to get <options>:
   shift
   shift
   diffview -ndim $numLongGridPts $numLatGridPts {evolution/}$f1{.r4} {evolution/}$f2{.r4} $argv &
else
   diffview -ndim $numLongGridPts $numLatGridPts {evolution/}$f1{.r4} {evolution/}$f2{.r4} &
endif
